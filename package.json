{
  "name": "arena-arcade",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-game browser arcade portal. Add a game by dropping it in games/ and adding an entry to games/catalog.js.",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "node tools/build-games.mjs",
    "test": "node games/apex/tests/boot.test.mjs && node games/apex/tests/game.test.mjs"
  },
  "workspaces": [
    "games/*"
  ],
  "keywords": [
    "games",
    "arcade",
    "webgl",
    "html5",
    "canvas",
    "runner",
    "typing"
  ],
